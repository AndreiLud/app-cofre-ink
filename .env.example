# Cofre Ink, server mode.
#
# Copy this file to .env and fill in COFRE_SECRET. That is the only line that has to be
# filled for the container, and everything left commented falls through to a default
# that already suits it.
#
# A line that is commented here is not a line that does not matter. Compose reads this
# file, and anything set here wins over compose.yaml, so a value left in by accident is
# a value that overrides the container. The two that matter most say so where they are.
#
# Compose is the only thing that reads this file. Running the server without a container,
# which is what `pnpm dev` does, reads the environment of the process instead, so the
# variables have to be exported there or passed with `node --env-file=.env`.

# Where the API listens.
COFRE_PORT=4321

# Where the data lives.
#   a path ending in .db  ->  SQLite, one file, perfect for a home server
#   a postgres url        ->  PostgreSQL, for the cloud or a bigger setup
#
# Left commented on purpose, and this is the line that matters most in the file.
#
# Compose reads this file and whatever it finds here wins over the default in
# compose.yaml, which is /data/cofre.db, the folder the named volume is mounted at.
# A path written here that is not /data puts the database inside the container, where
# it is deleted the next time the container is recreated, which is what an update does.
# The data is gone and nothing says so until somebody looks.
#
# So leave it alone unless you mean it. The container already knows where to write, and
# running outside a container without it writes to ./data/cofre.db beside the process.
#
# Fill it in for PostgreSQL, or to put the SQLite file somewhere of your own:
#   COFRE_DATABASE=postgres://cofre:senha@localhost:5432/cofre
#   COFRE_DATABASE=/data/cofre.db
# COFRE_DATABASE=

# Signs the session cookies. Without it nobody stays signed in, and with a weak one
# anybody can forge a session. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
COFRE_SECRET=

# The two addresses, and both of them have to be the one people actually type.
#
# COFRE_WEB_ORIGIN is where the interface is served from. The API accepts requests from
# there and from its own address below, and from nowhere else, and every invitation link
# is built with it. COFRE_PUBLIC_URL is where this server answers, seen from outside
# rather than from inside the container.
#
# Left commented for the same reason as the database above: what is written here wins
# over the default in compose.yaml, and a development address left in by accident sends
# every invitation to a port nothing answers. The container serves its own interface, so
# the two are the same address, and the default is http://localhost:4321.
#
# Put the real address in both the moment this server is reachable as anything other
# than localhost:
#   COFRE_WEB_ORIGIN=https://cofre.suacasa.com
#   COFRE_PUBLIC_URL=https://cofre.suacasa.com
#
# One case where they differ: using the interface published at https://app.cofre.ink
# with this server. Put that address in COFRE_WEB_ORIGIN and this server's own in
# COFRE_PUBLIC_URL. That makes the two different sites as a browser counts them, so the
# session cookie is written to travel between them, and for that this server has to
# answer over https, because a browser keeps no such cookie without a certificate.
# COFRE_WEB_ORIGIN=
# COFRE_PUBLIC_URL=

# Set this to serve the built interface from the same process, which is what the
# container does. Leave it empty while developing, when Vite serves the interface.
# COFRE_STATIC_DIR=./public

# Only when a reverse proxy sits in front of this server. Name the header it sets with
# the address of the real caller, and the limit on sign in attempts starts counting per
# person instead of counting everybody as one. Leave it empty if nothing sits in front,
# because then the header would be whatever the caller typed.
#
# The limit itself is five sign in attempts a minute and five new accounts an hour, set
# in apps/server/src/auth.ts, where it can be read and changed.
#   COFRE_CLIENT_IP_HEADER=x-forwarded-for
# COFRE_CLIENT_IP_HEADER=

# How much work a browser does before this server reads a password, in leading zero
# bits of a hash. Eighteen is about a second on a phone and about a second on every
# single attempt for anything trying passwords in bulk, which is the whole point: the
# limit above counts per address, and this one cannot be walked past with more
# addresses. Nothing is sent anywhere, and nobody is asked to read letters in a picture.
#
# Twenty is four times the cost, sixteen a quarter of it. Zero turns it off, which is
# for somebody who already has a gate of their own in front.
COFRE_PROOF_BITS=18

# Optional, and off unless you fill both in: a Cloudflare Turnstile widget on top of the
# work above. It is a third party being told the address of everybody who opens your
# sign in page, so it is a choice and not a default. The site key is public and goes to
# the browser; the secret stays here.
#   COFRE_TURNSTILE_SITE_KEY=
#   COFRE_TURNSTILE_SECRET=

NODE_ENV=production
